function list {
    echo "${WS_STORE}"
    ls --hide="*.log" --hide="*.sh" $WS_STORE | tr ' ' '\n'
}

function cat_config {
    local config="$1"
    [ -z "$config" ] && error_help "cat: no config stated "
    local config_store="$WS_STORE/$config"
    [ ! -f $config_store ] && error_exit 1 "Configuration $config does not exist"
    echo ">>Full config"
    cat ${config_store}
    echo ">>Restore script"
    cat ${config_store}.sh
    echo ">>Last restore script output"
    if [ -f "${config_store}.log" ] ; then
        cat ${config_store}.log
    else
        echo "No output available (never restored?)"
    fi
}

function ensure_exe_in_path {
    local i
    for i in $@ ; do
        local exef=`which $i`
        [ ! -x "$exef" ] && error_exit 1 "Required executable $i not in path!"
    done
}

function delete {
    local config="$1"
    [ -z "$config" ] && error_help "delete: no config stated "
    local config_store="$WS_STORE/$config"
    \rm -f ${config_store} > /dev/null 2>&1
    \rm -f ${config_store}.* > /dev/null 2>&1
}

function info_ {
    local config=`find_config`
    if [ ! -z "$config" ] ; then
        echo "Matching configuration \"$config\" exists, would be used to auto restore"
        cat_config $config
    else
        echo "No matching configuration exists, this would be stored..."
        local tmp_config="__very_unli_kely__co_nfig_name__"
        store $tmp_config
        cat_config $tmp_config
        delete $tmp_config
    fi
}

function current_config {
    local config=`find_config`
    if [ ! -z "$config" ] ; then
        echo "Matching configuration is \"$config\""
    else
        echo "No matching configuration exists"
    fi
}

function get_active_outputs {
    echo `xrandr | grep " connected" | grep -E "[0-9]+x[0-9]+\+[0-9]+\+[0-9]+*" | cut -d ' ' -f1`
}

function get_active_output_x_coord {
    local output="$1"
    echo `xrandr | grep "$output connected" | cut -d ' ' -f3 | cut -d '+' -f2`
}

function toggle_outputs {
    local active_outputs=`get_active_outputs`
    [ "`echo $active_outputs | cut -d ' ' -f3`" != "" ] && error_exit 1 "Must have exactly two outputs connected, check xrandr output"
    local output1=`echo $active_outputs | cut -d ' ' -f1`
    local output2=`echo $active_outputs | cut -d ' ' -f2`
    if [ "`get_active_output_x_coord $output1`" = "0" ] ; then
        #output1 to the left of output2
        xrandr --output $output1 --right-of $output2
    else
        #output1 to the right of output2
        xrandr --output $output1 --left-of $output2
    fi
}

#main

ensure_exe_in_path i3-msg xrandr

mkdir -p $WS_STORE || error_exit 1 "Failed to create $WS_STORE, needed to store workspace states"

option_force=false
while : ; do
    case "$1" in
        -f|--force) shift ; option_force=true ; ;;
        -s|--store) shift ; store "$1" ; exit $? ;;
        -d|--delete) shift ; delete "$1" ; exit $? ;;
        -as|--auto-store) shift ; auto_store ; exit $? ;;
        -ar|--auto-restore) shift ; auto_restore ; exit $? ;;
        -r|--restore) shift ; restore "$1" ; exit $? ;;
        -l|--list) shift ; list ; exit $? ;;
        -c|--cat) shift ; cat_config "$1" ; exit $? ;;
        -i|--info) shift ; info_ ; exit $? ;;
        -cc|--current-config) shift ; current_config ; exit $? ;;
        -to|--toggle-outputs) shift ; toggle_outputs ; exit $? ;;
        -x) get_signature ; exit $? ;;
        *) error_help "Unknown argument $1"
    esac
done
